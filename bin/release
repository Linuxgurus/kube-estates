#!/usr/bin/env bash
# release — cut a module-library tag that consumers can pin.
#
#   bin/release v0.2.0
#
# Refuses unless: on `main`, clean tree, and `main` equals `origin/main`. A tag cut from an
# uncommitted tree is a pin that resolves to something nobody reviewed, and a tag cut from a
# stale `main` is a pin that silently excludes the merge someone just did.
#
# It tags, pushes the tag, and stops. Moving the consumers is `ref-bump` in the estate repo —
# a separate act, because a release is not an apply and a tag is not a roll.
set -euo pipefail
cd "$(dirname "$0")/.." || exit 2

tag="${1:-}"
case "$tag" in
  v[0-9]*) ;;
  "") echo "usage: bin/release vX.Y.Z" >&2; exit 2 ;;
  *) echo "release: tag must start with v (got '$tag') — v* is the protected pattern" >&2; exit 2 ;;
esac

branch=$(git rev-parse --abbrev-ref HEAD)
[ "$branch" = "main" ] || { echo "release: on '$branch', not main" >&2; exit 2; }
[ -z "$(git status --porcelain)" ] || { echo "release: working tree is dirty" >&2; git status -s >&2; exit 2; }

git fetch -q origin main
local_sha=$(git rev-parse HEAD)
origin_sha=$(git rev-parse origin/main)
[ "$local_sha" = "$origin_sha" ] || {
  echo "release: main ($(git rev-parse --short HEAD)) is not origin/main ($(git rev-parse --short origin/main))" >&2
  exit 2
}

if git rev-parse -q --verify "refs/tags/$tag" >/dev/null; then
  echo "release: $tag already exists — tags are not moved. Cut a new version instead." >&2
  exit 2
fi

git tag -a "$tag" -m "modules $tag"
git push -q origin "$tag"

# Consumers of a PUBLIC module source (e.g. soma, whose modules come from
# github.com/Linuxgurus/kube-estates) resolve the tag over the mirror, not over the forge. The
# mirror is fast — measured ~10 s for a new tag — but it is not instant, so give it room rather
# than let a pin race it. The wait is a floor, not a guarantee: poll the public remote and only
# report success when the tag is actually there.
MIRROR="${MODULE_MIRROR:-https://github.com/Linuxgurus/kube-estates.git}"
echo "waiting for $tag on the mirror ($MIRROR) ..."
found=""
for i in $(seq 1 12); do
  sleep 5
  if git ls-remote --tags "$MIRROR" "refs/tags/$tag" 2>/dev/null | grep -q .; then
    found="$((i * 5))"
    break
  fi
done

echo "released $tag -> $(git rev-parse --short HEAD)"
if [ -n "$found" ]; then
  echo "mirror has it after ${found}s"
else
  echo "WARNING: $tag is not on the mirror after 60s. Consumers fetching from $MIRROR will fail" >&2
  echo "         until it lands. The tag exists on the forge; do not delete and re-cut it." >&2
fi
echo
echo "consumers still pin whatever they pinned. To move them (plan first, never apply):"
echo "    ~/code/terraform/bin/ref-bump $tag"
